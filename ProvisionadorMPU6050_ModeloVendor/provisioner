// Estructura del paquete de datos (no usa datos estandar, usa datos propios del modelo vendor)
typedef struct __attribute__((packed)) {
    int16_t accel_x;
    int16_t accel_y;
    int16_t accel_z;
    int16_t gyro_x;
    int16_t gyro_y;
    int16_t gyro_z;
} sensor_packet_t;

// Variables para almacenar los datos recibidos
static sensor_packet_t ultimos_datos_sensor = {0};



static uint8_t dev_uuid[16];

