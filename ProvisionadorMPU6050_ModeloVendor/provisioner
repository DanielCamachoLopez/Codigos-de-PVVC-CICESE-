// Callback para manejar mensajes del modelo vendor. Aquí es donde recibimos los datos del sensor.
static void example_ble_mesh_custom_model_cb(esp_ble_mesh_model_cb_event_t event,
                                             esp_ble_mesh_model_cb_param_t *param)
{
    switch (event) {
    case ESP_BLE_MESH_MODEL_OPERATION_EVT: {
        // Verificar que el opcode recibido es el de nuestros datos del sensor
        if (param->model_operation.opcode == VENDOR_OP_SENSOR_DATA) {
            
           
            uint8_t *data = param->model_operation.msg;
            uint16_t len = param->model_operation.length;
            
            // Verificar que tenemos datos suficientes
            if (len == sizeof(sensor_packet_t)) {
                
                // Copiar los datos recibidos
                memcpy(&ultimos_datos_sensor, data, sizeof(sensor_packet_t));
                
                ESP_LOGI(TAG, "----------------------------------------");
                ESP_LOGI(TAG, " DATOS MPU-6050 RECIBIDOS:");
                ESP_LOGI(TAG, "----------------------------------------");
                
                float accel_x_g = (float)ultimos_datos_sensor.accel_x / 16384.0f;
                float accel_y_g = (float)ultimos_datos_sensor.accel_y / 16384.0f;
                float accel_z_g = (float)ultimos_datos_sensor.accel_z / 16384.0f;
                
                ESP_LOGI(TAG, "Aceleración X: %d (%.3f g)", ultimos_datos_sensor.accel_x, accel_x_g);
                ESP_LOGI(TAG, "Aceleración Y: %d (%.3f g)", ultimos_datos_sensor.accel_y, accel_y_g);
                ESP_LOGI(TAG, "Aceleración Z: %d (%.3f g)", ultimos_datos_sensor.accel_z, accel_z_g);
                ESP_LOGI(TAG, "----------------------------------------");
                ESP_LOGI(TAG, "Giroscopio X: %d", ultimos_datos_sensor.gyro_x);
                ESP_LOGI(TAG, "Giroscopio Y: %d", ultimos_datos_sensor.gyro_y);
                ESP_LOGI(TAG, "Giroscopio Z: %d", ultimos_datos_sensor.gyro_z);
                
                float magnitud = sqrtf(accel_x_g*accel_x_g + accel_y_g*accel_y_g + accel_z_g*accel_z_g);
                const char *estado = (magnitud > 1.2f) ? "🚗 EN MOVIMIENTO" : "REPOSO";
                
                ESP_LOGI(TAG, "----------------------------------------");
                ESP_LOGI(TAG, "Magnitud: %.3f g", magnitud);
                ESP_LOGI(TAG, "Estado: %s", estado);
                
                // FORMATO PARA PYTHON
                ESP_LOGI(TAG, "COCHE_DATA:%d,%d,%d,%d,%d,%d", 
                    ultimos_datos_sensor.accel_x, 
                    ultimos_datos_sensor.accel_y, 
                    ultimos_datos_sensor.accel_z,
                    ultimos_datos_sensor.gyro_x, 
                    ultimos_datos_sensor.gyro_y, 
                    ultimos_datos_sensor.gyro_z);
                
                ESP_LOGI(TAG, "----------------------------------------");
            } else {
                ESP_LOGE(TAG, "Tamaño de paquete incorrecto: esperado %d, recibido %d", 
                         sizeof(sensor_packet_t), len);
            }
        }
        break;
    }
    case ESP_BLE_MESH_MODEL_SEND_COMP_EVT:
        if (param->model_send_comp.err_code != ESP_OK) {
            ESP_LOGE(TAG, "Failed to send message 0x%06" PRIx32, param->model_send_comp.opcode);
        }
        break;
    default:
        break;
    }
}

static esp_err_t ble_mesh_init(void)
{
    uint8_t match[2] = {0xdd, 0xdd};
    esp_err_t err = ESP_OK;

    prov_key.net_idx = ESP_BLE_MESH_KEY_PRIMARY;
    prov_key.app_idx = APP_KEY_IDX;
    memset(prov_key.app_key, APP_KEY_OCTET, sizeof(prov_key.app_key));

    esp_ble_mesh_register_prov_callback(example_ble_mesh_provisioning_cb);
    esp_ble_mesh_register_config_client_callback(example_ble_mesh_config_client_cb);
    esp_ble_mesh_register_generic_client_callback(example_ble_mesh_generic_client_cb);
    
    // Registramos el callback para modelos custom (vendor)
    esp_ble_mesh_register_custom_model_callback(example_ble_mesh_custom_model_cb);

    err = esp_ble_mesh_init(&provision, &composition); 
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "Failed to initialize mesh stack (err %d)", err);
        return err;
    }

    err = esp_ble_mesh_provisioner_set_dev_uuid_match(match, sizeof(match), 0x0, false);
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "Failed to set matching device uuid (err %d)", err);
        return err;
    }

    err = esp_ble_mesh_provisioner_prov_enable((esp_ble_mesh_prov_bearer_t)(ESP_BLE_MESH_PROV_ADV | ESP_BLE_MESH_PROV_GATT));
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "Failed to enable mesh provisioner (err %d)", err);
        return err;
    }

    err = esp_ble_mesh_provisioner_add_local_app_key(prov_key.app_key, prov_key.net_idx, prov_key.app_idx);
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "Failed to add local AppKey (err %d)", err);
        return err;
    }

    ESP_LOGI(TAG, "BLE Mesh Provisioner initialized");

    return err;
}

void app_main(void)
{
    esp_err_t err;

    ESP_LOGI(TAG, "Initializing...");

    err = nvs_flash_init();
    if (err == ESP_ERR_NVS_NO_FREE_PAGES) {
        ESP_ERROR_CHECK(nvs_flash_erase());
        err = nvs_flash_init();
    }
    ESP_ERROR_CHECK(err);

    err = bluetooth_init();
    if (err) {
        ESP_LOGE(TAG, "esp32_bluetooth_init failed (err %d)", err);
        return;
    }

    ble_mesh_get_dev_uuid(dev_uuid);

    err = ble_mesh_init();
    if (err) {
        ESP_LOGE(TAG, "Bluetooth mesh init failed (err %d)", err);
    }
}
