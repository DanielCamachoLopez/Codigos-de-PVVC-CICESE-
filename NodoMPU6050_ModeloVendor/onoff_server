// Inicialización del bus I2C
static void i2c_master_init(void) { 
    i2c_config_t conf = {
        .mode = I2C_MODE_MASTER,
        .sda_io_num = I2C_MASTER_SDA_IO,
        .sda_pullup_en = GPIO_PULLUP_ENABLE,
        .scl_io_num = I2C_MASTER_SCL_IO,
        .scl_pullup_en = GPIO_PULLUP_ENABLE,
        .master.clk_speed = I2C_MASTER_FREQ_HZ,
    };
    i2c_param_config(I2C_MASTER_NUM, &conf);
    i2c_driver_install(I2C_MASTER_NUM, conf.mode, 0, 0, 0);
    ESP_LOGI(TAG, "I2C inicializado correctamente");
}

// Función para escribir en registro del MPU-6050 las configuraciones del mismo (Cómo debe operar)
static esp_err_t mpu6050_register_write_byte(uint8_t reg_addr, uint8_t data) { //Declarar que escribe 1 byte en el registro
    int ret; // Se guarda el resultado de la comunicación
    i2c_cmd_handle_t cmd = i2c_cmd_link_create(); // Crea el paquete de comandos que se van a enviar por I2C
    i2c_master_start(cmd); // Inicia la comunicación I2C
    i2c_master_write_byte(cmd, (MPU6050_SENSOR_ADDR << 1) | I2C_MASTER_WRITE, true); // Enviar dirección de MPU y será escritura
    i2c_master_write_byte(cmd, reg_addr, true); // Indica el registro al que se va a escribir
    i2c_master_write_byte(cmd, data, true); // Envpia el valor que se guardará en ese registro
    i2c_master_stop(cmd); // Termina la comunicación I2C
    ret = i2c_master_cmd_begin(I2C_MASTER_NUM, cmd, 1000 / portTICK_PERIOD_MS); // Envía el paquete de comandos por el bus I2C
    i2c_cmd_link_delete(cmd); // Libera la memoria del paquete de comandos usado
    return ret; // Retorna el resultado de la comunicacióm 
}

// Función para leer los datos del sensor MPU-6050
static esp_err_t mpu6050_register_read(uint8_t reg_addr, uint8_t *data, size_t len) { // Función que lee datos del sensor
    int ret; // Variable para saber el resultado de la comunicación
    i2c_cmd_handle_t cmd = i2c_cmd_link_create(); // Crea el comando I2C que se va a enviar
    i2c_master_start(cmd); // Inicia la comunicación I2C
    i2c_master_write_byte(cmd, (MPU6050_SENSOR_ADDR << 1) | I2C_MASTER_WRITE, true); // Indica el registro que quiere leer
    i2c_master_write_byte(cmd, reg_addr, true); // Envía el registro que se quiere leer
    i2c_master_start(cmd); // Se reinicia la comunicación para cambiar a modo lectura
    i2c_master_write_byte(cmd, (MPU6050_SENSOR_ADDR << 1) | I2C_MASTER_READ, true); // Indica que queremos saber el valor del registro
    if (len > 1) { // Se leeran todos los bytes menos el último 
        i2c_master_read(cmd, data, len - 1, I2C_MASTER_ACK);
    }
    i2c_master_read_byte(cmd, data + len - 1, I2C_MASTER_NACK); // Avisa que se ha leído el último byte
    i2c_master_stop(cmd); // Termina la comunicación I2C
    ret = i2c_master_cmd_begin(I2C_MASTER_NUM, cmd, 1000 / portTICK_PERIOD_MS); // Ejecuta todo. Envía el comando
    i2c_cmd_link_delete(cmd); // Libera la memoria del comando usado
    return ret; // Retorna el resultado de la comunicación
}

// Inicializa el sensor MPU-6050
static void mpu6050_init_sensor(void) {
    ESP_LOGI(TAG, "Inicializando sensor MPU-6050...");

    // Verificar comunicación leyendo el registro WHO_AM_I
    uint8_t who_am_i;
    esp_err_t ret = mpu6050_register_read(MPU6050_WHO_AM_I_REG, &who_am_i, 1);
    if (ret != ESP_OK) {
        ESP_LOGE(TAG, "Error comunicándose con MPU-6050: %s", esp_err_to_name(ret));
        return;
    }
    
    ESP_LOGI(TAG, "MPU-6050 WHO_AM_I = 0x%02X", who_am_i);
    
    if (who_am_i != 0x68) {
        ESP_LOGE(TAG, "Dispositivo MPU-6050 no encontrado");
        return;
    }
    
    // Despertar el sensor (escribir 0 al registro PWR_MGMT_1)
    ret = mpu6050_register_write_byte(MPU6050_PWR_MGMT_1_REG, 0x00);
    if (ret != ESP_OK) {
        ESP_LOGE(TAG, "Error inicializando MPU-6050: %s", esp_err_to_name(ret));
        return;
    }
    
    ESP_LOGI(TAG, "Sensor MPU-6050 inicializado correctamente");
}

// Leer datos del acelerómetro y giroscopio
static esp_err_t mpu6050_read_sensor_data(void) {
    uint8_t data[14];
    esp_err_t ret = mpu6050_register_read(MPU6050_ACCEL_XOUT_H_REG, data, 14); // Lee 14 bytes desde el inicio
    
    if (ret != ESP_OK) {
        ESP_LOGE(TAG, "Error leyendo datos del MPU-6050: %s", esp_err_to_name(ret));
        return ret;
    }
    
    // Convertir datos del acelerómetro (vienen en forma de big-endian).
    mpu6050_data.accel_x = (int16_t)((data[0] << 8) | data[1]);
    mpu6050_data.accel_y = (int16_t)((data[2] << 8) | data[3]);
    mpu6050_data.accel_z = (int16_t)((data[4] << 8) | data[5]);
    
    // Convertir datos del giroscopio
    mpu6050_data.gyro_x = (int16_t)((data[8] << 8) | data[9]);
    mpu6050_data.gyro_y = (int16_t)((data[10] << 8) | data[11]);
    mpu6050_data.gyro_z = (int16_t)((data[12] << 8) | data[13]);
    
    return ESP_OK;
}

