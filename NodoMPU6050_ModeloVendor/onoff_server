// Envía los datos del sensor por el modelo vendor.
static void enviar_todos_los_datos_sensor(void) {
    if (!esp_ble_mesh_node_is_provisioned()) { // Si no está provisionado, no se pueden enviar datos
        ESP_LOGW(TAG, "Nodo no provisionado aún...");
        return;
    }

    esp_err_t ret = mpu6050_read_sensor_data(); // Se extraen los datos del sensor y se guardan para empaquetarlos después
    if (ret != ESP_OK) {
        ESP_LOGE(TAG, "Error leyendo MPU-6050: %s", esp_err_to_name(ret));
        return;
    }

    // Los datos del sensor se empaquetan en la estructura del paquete que se va a enviar.
    sensor_packet_t packet = {
        .accel_x = mpu6050_data.accel_x,
        .accel_y = mpu6050_data.accel_y,
        .accel_z = mpu6050_data.accel_z,
        .gyro_x  = mpu6050_data.gyro_x,
        .gyro_y  = mpu6050_data.gyro_y,
        .gyro_z  = mpu6050_data.gyro_z
    };

    // Mostrar los valores en consoola
    ESP_LOGI(TAG, "Enviando datos:");
    ESP_LOGI(TAG, "Accel -> X:%d Y:%d Z:%d",
            packet.accel_x,
            packet.accel_y,
            packet.accel_z);

    ESP_LOGI(TAG, "Gyro  -> X:%d Y:%d Z:%d",
            packet.gyro_x,
            packet.gyro_y,
            packet.gyro_z);

    esp_err_t err = esp_ble_mesh_model_publish( // Se publica el mensaje con los datos del sensor usando el modelo vendor 
        vendor_model_ptr, // Modelo personalizado
        VENDOR_OP_SENSOR_DATA, // Opcode definido para los datos del sensor (Dispositivo sensor)
        sizeof(sensor_packet_t), // Tamaño de la publicación 
        (uint8_t *)&packet, // Convierte la estructura en bytes porque BLE Mesh solo entiende Bytes
        ROLE_NODE
    );

    if (err != ESP_OK) {
        ESP_LOGE(TAG, "Error publicando sensor: %s", esp_err_to_name(err));
    } else {
        ESP_LOGI(TAG, "Datos enviados por Vendor Model!!!!!!!");
    }
}
